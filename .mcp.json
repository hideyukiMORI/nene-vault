{
  "mcpServers": {
    "nene-vault": {
      "command": "php",
      "args": [
        "tools/local-mcp-server.php"
      ],
      "env": {
        "NENE2_LOCAL_API_BASE_URL": "http://localhost:8600",
        "NENE2_LOCAL_JWT_SECRET": "${NENE2_LOCAL_JWT_SECRET}"
      }
    },
    "cc-vault": {
      "command": "node",
      "args": [
        "/home/xi/docker/_work/tools/chat-relay/ccbridge.mjs"
      ],
      "env": {
        "CC_CHANNEL_PORT": "8814"
      }
    }
  }
}
